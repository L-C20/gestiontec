# Copiá este archivo a ".env" y completá los valores reales.
# .env NUNCA se sube a git (ver .gitignore).

# Puerto (Railway lo asigna automáticamente en producción)
PORT=3000

# URL pública del sitio (sin barra al final). En local con ngrok, la URL de ngrok.
# En Railway, la URL que te da Railway una vez desplegado.
PUBLIC_BASE_URL=http://localhost:3000

# Mercado Pago — Access Token de tu cuenta (panel de developers).
# Usá el de PRUEBA mientras testeás, y el de PRODUCCIÓN recién cuando esté todo validado.
MP_ACCESS_TOKEN=

# Email de aviso, vía Resend (API HTTP — Railway bloquea SMTP en planes gratis/hobby):
# 1. Creá una cuenta gratis en https://resend.com
# 2. Panel → API Keys → Create API Key → copiá el valor (empieza con "re_")
# No hace falta verificar dominio propio para probar: se puede mandar desde
# "onboarding@resend.dev" (dejar RESEND_FROM vacío usa ese remitente por defecto).
RESEND_API_KEY=
RESEND_FROM=

# A qué email te llega el aviso de cada suscripción/pago
NOTIFY_EMAIL_TO=

# WhatsApp vía CallMeBot (gratis, para autonotificarte):
# 1. Agendá el número +34 644 59 71 67 en tu WhatsApp
# 2. Mandale el mensaje: "I allow callmebot to send me messages"
# 3. Te responde con tu apikey
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
